==id $Id: openmakepath_lib.sfd 1.3 (17.11.2026) $
* "openmakepath.library": OpenMakeCore's paths (gs_layer.h): a part cut
* into layers, the pieces of wall welded into loops, and the toolpath
* (gs_toolpath.h) the slicer and the laser and CNC apps fill, and a
* printer's layers planned as one (gs_plan.h). Each call is its C
* function in snake case (GL_LoopArea is gl_loop_area); floats travel as
* their bits. Never reorder or take a call out; add new ones at the end.
* core/library/gen-library.py writes the rest from this.
==base _OpenMakePathBase
==basetype struct Library *
==libname openmakepath.library
==bias 30
==public
==include <exec/types.h>
==include <gs_layer.h>
==include <gs_toolpath.h>
==include <gs_plan.h>
float GL_Height(float h)(d0)
int GL_Layers(const gs_mesh *m, float h)(a0,d0)
float GL_LayerZ(const gs_mesh *m, float h, int layer)(a0,d0,d1)
int GL_Cut(const gs_mesh *m, float h, int layer, gl_walls *w)(a0,d0,d1,a1)
void GL_WallsFree(gl_walls *w)(a0)
void GL_Status(char *buf, int len, const gs_mesh *m, float h, int layer, const gl_walls *w)(a0,d0,a1,d1,d2,a2)
int GL_Weld(const gl_walls *w, float tol, gl_loops *out)(a0,d0,a1)
void GL_LoopsFree(gl_loops *out)(a0)
float GL_LoopArea(const gl_loop *l)(a0)
float GL_LoopLength(const gl_loop *l)(a0)
* 1.1: the loops inset, the toolpath and its fill
int GL_Inset(const gl_loops *in, float d, gl_loops *out)(a0,d0,a1)
void GT_Init(gt_path *p)(a0)
void GT_Free(gt_path *p)(a0)
int GT_Layer(gt_path *p)(a0)
int GT_Add(gt_path *p, int kind, float x, float y, float z, float w)(a0,d0,d1,d2,d3,d4)
int GT_Loop(gt_path *p, int kind, const gl_loop *l, float z, float w)(a0,d0,a1,d1,d2)
int GT_Append(gt_path *dst, const gt_path *src)(a0,a1)
float GT_Length(const gt_path *p, int kind)(a0,d0)
int GT_Bounds(const gt_path *p, float *min, float *max)(a0,a1,a2)
int GT_Fill(gt_path *p, const gl_loops *region, const gl_loops *const *solid, int nsolid, float z, float w, int every, int cross)(a0,a1,a2,d0,d1,d2,d3,d4)
* 1.2: a printer's layers as a toolpath
* 1.3: more for a layer (gp_more: top and bottom apart, a grid, a skirt, a gap)
void GP_Defaults(gp_opts *o)(a0)
int GP_Layers(const gs_mesh *m, const gp_opts *o)(a0,a1)
int GP_Layer(gt_path *p, const gs_mesh *m, const gp_opts *o, int n)(a0,a1,a2,d0)
void GP_Place(gs_mesh *m, float bed_x, float bed_y)(a0,d0,d1)
int GP_Part(gt_path *p, const gs_mesh *m, const gp_opts *o)(a0,a1,a2)
void GP_MoreDefaults(gp_more *x)(a0)
int GP_LayerMore(gt_path *p, const gs_mesh *m, const gp_opts *o, const gp_more *x, int n)(a0,a1,a2,a3,d0)
int GP_PartMore(gt_path *p, const gs_mesh *m, const gp_opts *o, const gp_more *x)(a0,a1,a2,a3)
int GT_FillGrid(gt_path *p, const gl_loops *region, const gl_loops *const *solid, int nsolid, float z, float w, int every, int cross)(a0,a1,a2,d0,d1,d2,d3,d4)
==end
